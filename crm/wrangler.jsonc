// Cloudflare Workers config for the Lodgely CRM (Next.js via OpenNext).
// Workers Builds: root directory "crm", build command
// "npx opennextjs-cloudflare build", deploy command "npx opennextjs-cloudflare deploy".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lodgely",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Stops esbuild injecting __name() into scripts Next.js serialises to the browser.
  "keep_names": false,
  // Lets Cloudflare run the app next to the database (Neon, Sydney) when that's faster for a
  // visitor. (An explicit "aws:ap-southeast-2" region hint caused intermittent 500s.)
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "lodgely" },
    // SkillSelect rounds watcher, run from this worker's cron (see cloudflare/worker.js).
    { "binding": "ROUNDS_WATCH", "service": "rounds-watch" }
  ],
  // Client documents and mail attachments (was Vercel Blob).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "lodgely-files" }],
  // Every 10 minutes: the rounds watcher; once a day (20:0x UTC) the mail sync. See cloudflare/worker.js.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
