# Supabase (Project Settings → API). The service-role key is NOT used by the app.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Email code length configured in Supabase Auth (6–10).
NEXT_PUBLIC_OTP_LENGTH=6

# Chat model — any OpenAI-compatible API (Groq, OpenRouter, xAI, Moonshot/Kimi, Mistral, …).
# Case files contain personal data: use a plan that doesn't train on or retain inputs.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional: embeddings for semantic search (must output 1024 dimensions).
# Without these, search is keyword-only. Use the same values in the crawler.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
